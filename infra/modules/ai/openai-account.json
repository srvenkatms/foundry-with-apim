                    "description": "The name of the model - often the same as the deployment name"
                  }
                },
                "version": {
                  "type": "string",
                  "metadata": {
                    "description": "The version of the model, e.g. \"2024-11-20\" or \"0125\""
                  }
                },
                "format": {
                  "type": "string",
                  "allowedValues": [
                    "Cohere",
                    "OpenAI"
                  ]
                }
              }
            }
          }
        },
        "sku": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "allowedValues": [
                "GlobalStandard",
                "Standard"
              ]
            },
            "capacity": {
              "type": "int"
            }
          },
          "nullable": true
        }
      },
      "metadata": {
        "__bicep_imported_from!": {
          "sourceTemplate": "ai-foundry.bicep"
        }
      }
    }
  },
  "parameters": {
